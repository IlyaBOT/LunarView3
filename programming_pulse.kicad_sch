	(text "Fast VPP pulse switch / indicator / ADC monitor"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left)
		)
		(uuid "557a9823-4b80-5628-846a-1f816f8b12a6")
	)
	(text "Arm Q3 while relay remains READ; settle HV_ARM; then pulse Q7 using PD2.\nPreflight measures actual switched VPP with socket isolated. Remove VPP before moving relay.\nPNP emitter = HV_ARM, collector = VPP_SW. VPP has a load-dependent VCE drop: calibrate under 30mA load.\nNo added VPP_SW capacitor. R37 returns pin22 LOW for byte verify. ADC filter is behind 120k.\nCommissioning requires measured <=50ns pin22 rise time and <14V overshoot for NM27C512.\nWRITE is locked in the default firmware build until the assembled pulse stage has passed these checks."
		(exclude_from_sim no)
		(at 20 275 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left)
		)
		(uuid "8d8b5232-480a-5d8f-ac0a-1261154d211d")
	)
