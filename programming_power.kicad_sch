	(text "Vout = 1.25*(1+(430+trim)/120) + Iadj*(430+trim).\nSet trim near 48 ohm; measure TP_6V25 unloaded and loaded.\nTO-220 tab is OUTPUT. At 25V/60mA dissipation is ~1.13W: heatsink.\n120 ohm feedback draws ~10.4mA, including with K1 in READ."
		(exclude_from_sim no)
		(at 20 277 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "338fc105-2d31-5e13-95fa-20b74309f48e")
	)
	(text "External regulated supply only: 12.5...25 V. Select the voltage for the exact device."
		(exclude_from_sim no)
		(at 20 28 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "4cea26ec-01a1-5093-b74c-9d4ce132c6cf")
	)
	(text "External VPP / high-side switch / 6.25 V regulator"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left)
		)
		(uuid "6d758f0c-cba8-5f09-a4bf-ff3426aaa0ae")
	)
	(text "Gate Zener: cathode to SOURCE/VPP_IN, anode to GATE.\nQ4 collector pulls gate through R31; emitter = GND.\nRESET LOW forces U10 output LOW immediately.\nPB1 is the hardware arming interlock; PD2 controls the final pulse switch."
		(exclude_from_sim no)
		(at 20 138 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
		)
		(uuid "d3f5b434-6c9b-5599-8931-f3ffe3cc76c2")
	)
