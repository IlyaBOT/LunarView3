  (text "J2: 1 MISO, 2 +5V, 3 SCK,\n4 MOSI, 5 RESET, 6 GND.\nNever power J2 and USB from competing sources." (at 20 241 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "6412d773-bd1c-5585-baec-5bce195f86c7"))
  (text "J3 names are from MCU viewpoint.\n1 = GND   2 = RX (PD0)   3 = TX (PD1)\nUse 5 V TTL UART; avoid simultaneous UART drivers." (at 124 241 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "a60c616f-8e75-5610-aaad-a12beb053db1"))
  (embedded_fonts no)
