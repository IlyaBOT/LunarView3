      "verify_algorithm": "National Fast Algorithm: verify after every pulse at VCC=6.25V / OE-VPP=VIL; final whole-image compare at VCC=5V",
      "power_sequence": [
        "inactive controls and input data",
        "arm internal HV with relay READ",
        "test VPP_SW with socket isolated",
        "VPP off and discharge verified",
        "relay PROGRAM; check 6.25V",
        "for each byte: enable VPP; drive data; CE low 100us; CE high; input data; VPP off; discharge; verify byte",
        "VPP off; internal HV off; relay READ; compare all bytes at 5V"
      ],
      "sources": [
