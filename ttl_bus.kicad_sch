	(text "TTL-compatible bidirectional buffer: preserves reads from older 27xx EPROMs"
		(exclude_from_sim no)
		(at 20 28 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left)
		)
		(uuid "a29b185a-112c-5323-8ed1-147cc9c1bf14")
	)
	(text "DIR = VPP_DRIVE: LOW -> target-to-MCU (READ/VERIFY); HIGH -> MCU-to-target (PROGRAM).\nOE# tied LOW. Firmware releases MCU data outputs BEFORE removing VPP.\n74HCT input VIH = 2.0V; MCU sees full 5V logic. Do not substitute 74HC245.\nMCU-side R10-R17 and D10-D17 are on data/status sheet. Target-side protection below."
		(exclude_from_sim no)
		(at 20 144 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left)
		)
		(uuid "a3d26570-33da-50ff-991e-6e5ee1ea1def")
	)
	(text "Target-side clamps keep +6.25V verify outputs away from the 5V buffer. Maximum nominal injection ~1mA/line.\nUSB-powered logic and relay draw more current than all eight clamps inject; never operate with USB absent."
		(exclude_from_sim no)
		(at 20 280 0)
		(effects
			(font
				(size 1.05 1.05)
			)
			(justify left)
		)
		(uuid "a707527a-f17b-55b7-971c-f4950e6c54cb")
	)
