  (text "CH340C: no 12 MHz crystal. R232 = GND (TTL mode).\nPins 7/8 are variant-dependent: leave unconnected.\nOnly DTR# (13) is used; other modem pins are NC." (exclude_from_sim no) (at 20 155 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "cd5bb5b2-5ad9-5897-8a62-c3c1bd80117d"))
