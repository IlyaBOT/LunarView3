  (text "J3 names are from MCU viewpoint.\n1 = GND   2 = RX (PD0)   3 = TX (PD1)\nUse 5 V TTL UART; avoid simultaneous UART drivers." (exclude_from_sim no) (at 124 241 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "051165f4-8095-5b6b-8ed1-beae86e82603"))
  (text "J2: 1 MISO, 2 +5V, 3 SCK,\n4 MOSI, 5 RESET, 6 GND.\nNever power J2 and USB from competing sources." (exclude_from_sim no) (at 20 241 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "63556fd0-9989-5c2a-8a5c-b3dccdbbe21e"))
