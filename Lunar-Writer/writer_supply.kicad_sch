  (text "Vboost = 1.23*(1+47k/2k) = 30.135V. L=100uH; Rc=470R; Cc=47uF; Cout=680uF.\nDesign load 100mA on 30V rail. Use 50V bulk capacitors, Cout ESR <=0.2ohm / ripple >=0.2A.\nValidate startup and load-step response; calculated compensation is not a measured stability test." (at 20 173 0) (effects (font (size 1.05 1.05)) (justify left)) (uuid "ae11d78d-66d3-59fb-a0b7-64be0e1a4b24"))
